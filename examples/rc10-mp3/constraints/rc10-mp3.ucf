# RC10 MP3 decoder pins (lines from data/boards/rc10.ucf, nets renamed).
# 48 MHz IFCLK from the FX2 (bank 4, 3.3 V)
NET "clk" LOC = "P10" | IOSTANDARD = LVCMOS33 ;
NET "clk" PERIOD = 20.833ns HIGH 50%;
# FX2 GPIF bus (banks 4/5, 3.3 V). D[7:0] is shared with the NAND flash; the
# design drives it only while nCS and SELn are low and nWR high.
NET "fx2_d<7>"  LOC = "U13" | IOSTANDARD = LVCMOS33 ;
NET "fx2_d<6>"  LOC = "T11" | IOSTANDARD = LVCMOS33 ;
NET "fx2_d<5>"  LOC = "P12" | IOSTANDARD = LVCMOS33 ;
NET "fx2_d<4>"  LOC = "R11" | IOSTANDARD = LVCMOS33 ;
NET "fx2_d<3>"  LOC = "T8"  | IOSTANDARD = LVCMOS33 ;
NET "fx2_d<2>"  LOC = "V8"  | IOSTANDARD = LVCMOS33 ;
NET "fx2_d<1>"  LOC = "R8"  | IOSTANDARD = LVCMOS33 ;
NET "fx2_d<0>"  LOC = "R6"  | IOSTANDARD = LVCMOS33 ;
NET "fx2_ncs"   LOC = "T14" | IOSTANDARD = LVCMOS33 ;   # GPIF CTL2
NET "fx2_nwr"   LOC = "V4"  | IOSTANDARD = LVCMOS33 ;   # GPIF CTL1
NET "fx2_seln"  LOC = "P13" | IOSTANDARD = LVCMOS33 ;   # GPIF2 = FX2 PA5: 0 = FPGA, 1 = flash
NET "fx2_full"  LOC = "R14" | IOSTANDARD = LVCMOS33 ;   # GPIF RDY1
NET "fx2_empty" LOC = "P14" | IOSTANDARD = LVCMOS33 ;   # GPIF RDY0
# LEDs, 7-segment (as in rc10-music)
NET "led<0>" LOC = "D2" | IOSTANDARD = LVCMOS25 | SLEW = SLOW | DRIVE = 8 ;
NET "led<1>" LOC = "D3" | IOSTANDARD = LVCMOS25 | SLEW = SLOW | DRIVE = 8 ;
NET "led<2>" LOC = "E1" | IOSTANDARD = LVCMOS25 | SLEW = SLOW | DRIVE = 8 ;
NET "led<3>" LOC = "E2" | IOSTANDARD = LVCMOS25 | SLEW = SLOW | DRIVE = 8 ;
NET "led<4>" LOC = "E3" | IOSTANDARD = LVCMOS25 | SLEW = SLOW | DRIVE = 8 ;
NET "led<5>" LOC = "F2" | IOSTANDARD = LVCMOS25 | SLEW = SLOW | DRIVE = 8 ;
NET "led<6>" LOC = "F4" | IOSTANDARD = LVCMOS25 | SLEW = SLOW | DRIVE = 8 ;
NET "led<7>" LOC = "G3" | IOSTANDARD = LVCMOS25 | SLEW = SLOW | DRIVE = 8 ;
NET "seg0<0>" LOC = "H2" | IOSTANDARD = LVCMOS25 ;   # a
NET "seg0<1>" LOC = "H3" | IOSTANDARD = LVCMOS25 ;   # b
NET "seg0<2>" LOC = "H6" | IOSTANDARD = LVCMOS25 ;   # c
NET "seg0<3>" LOC = "H5" | IOSTANDARD = LVCMOS25 ;   # d
NET "seg0<4>" LOC = "G5" | IOSTANDARD = LVCMOS25 ;   # e
NET "seg0<5>" LOC = "G4" | IOSTANDARD = LVCMOS25 ;   # f
NET "seg0<6>" LOC = "H1" | IOSTANDARD = LVCMOS25 ;   # g
NET "seg0<7>" LOC = "C2" | IOSTANDARD = LVCMOS25 ;   # dp
NET "seg1<0>" LOC = "J1" | IOSTANDARD = LVCMOS25 ;   # a
NET "seg1<1>" LOC = "J2" | IOSTANDARD = LVCMOS25 ;   # b
NET "seg1<2>" LOC = "K2" | IOSTANDARD = LVCMOS25 ;   # c
NET "seg1<3>" LOC = "C3" | IOSTANDARD = LVCMOS25 ;   # d
NET "seg1<4>" LOC = "C1" | IOSTANDARD = LVCMOS25 ;   # e
NET "seg1<5>" LOC = "H4" | IOSTANDARD = LVCMOS25 ;   # f
NET "seg1<6>" LOC = "B1" | IOSTANDARD = LVCMOS25 ;   # g
NET "seg1<7>" LOC = "J4" | IOSTANDARD = LVCMOS25 ;   # dp
# Joystick and audio (as in rc10-pcm-player)
NET "joy<4>" LOC = "B10" | IOSTANDARD = LVCMOS33 ;   # JOY_SELECT
NET "joy<3>" LOC = "A11" | IOSTANDARD = LVCMOS33 ;   # JOY_DOWN
NET "joy<2>" LOC = "B13" | IOSTANDARD = LVCMOS33 ;   # JOY_UP
NET "joy<1>" LOC = "D10" | IOSTANDARD = LVCMOS33 ;   # JOY_RIGHT
NET "joy<0>" LOC = "A10" | IOSTANDARD = LVCMOS33 ;   # JOY_LEFT
NET "audio_l" LOC = "U4" | IOSTANDARD = LVCMOS33 ;
NET "audio_r" LOC = "V5" | IOSTANDARD = LVCMOS33 ;
NET "piezo<0>" LOC = "U6" | IOSTANDARD = LVCMOS33 ;
NET "piezo<1>" LOC = "V7" | IOSTANDARD = LVCMOS33 ;
# Clock-domain crossings: paths into the first synchroniser flip-flops
# (names ending _s1) go between the 48 MHz and DAC clocks and are not timed.
INST "*_s1*" TNM = "SYNC_FIRST";
TIMESPEC "TS_sync" = TO "SYNC_FIRST" TIG;
# The DAC clock is a BUFGMUX of clock A (44.1 MHz, from the DCMs) and the
# 48 MHz. ISE treats the two as related and times DAC paths launched on one
# and captured on the other (a 0.14 ns phase step), which only a switch
# could do. A FROM-TO (it outranks the derived PERIOD) gives every path in
# the DAC domain the plain 48 MHz requirement instead: right for either.
NET "u_aclk.aclk" TNM_NET = "TN_dac";
TIMESPEC "TS_dac" = FROM "TN_dac" TO "TN_dac" 20.833 ns;
# The BUFGMUX select may change at any time (the mux switches when it is
# safe); it changes once per stream rate, with reads held off.
INST "use48_q*" TNM = "TN_sel";
TIMESPEC "TS_sel" = FROM "TN_sel" TIG;
